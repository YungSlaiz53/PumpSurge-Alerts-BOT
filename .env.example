# ==============================================================================
# PUMPSURGE - SOLANA PUMP.FUN SNIPING & 5X/10X ALERT APP CONFIGURATION
# ==============================================================================

# Server Environment & Port (Render.com automatically injects PORT=10000)
PORT=3000
NODE_ENV="production"

# ------------------------------------------------------------------------------
# SOLANA RPC & WEBSOCKET CONFIGURATION
# ------------------------------------------------------------------------------
# For production sub-second sniping, use dedicated high-speed RPC/WSS endpoints:
# Helius:    https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Shyft:     https://rpc.shyft.to?api_key=YOUR_KEY
# QuickNode: https://solana-mainnet.quiknode.pro/YOUR_KEY/
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_WSS_URL="wss://api.mainnet-beta.solana.com"

# Commitment level for WebSocket stream ('processed' for sub-second, 'confirmed' for standard)
SOLANA_COMMITMENT="processed"

# ------------------------------------------------------------------------------
# PUMP.FUN PROTOCOL CONSTANTS & SURGE SETTINGS
# ------------------------------------------------------------------------------
# Pump.fun Program ID
PUMP_PROGRAM_ID="6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P"

# Maximum duration (in seconds) to track token velocity for multiplier spikes
PRICE_SURGE_WINDOW_SECONDS=90

# Surge trigger thresholds for in-app and desktop notifications
ALERT_SURGE_MULTIPLIER_5X=5.0
ALERT_SURGE_MULTIPLIER_10X=10.0

# Estimated SOL price in USD for real-time market cap calculations
DEFAULT_SOL_USD_PRICE=180.0
