# ==============================================================================
# PUMP.FUN TELEGRAM SNIPING & ALERT BOT - CONFIGURATION
# ==============================================================================

# Telegram Bot Token (obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ123456789"

# Telegram Channel ID to broadcast new listings and 5x/10x alerts
# For public channels: @YourChannelUsername
# For private channels: -1001234567890 (Numeric ID starting with -100)
TELEGRAM_CHANNEL_ID="@PumpFunAlphaAlerts"

# Optional Telegram Admin User ID for bot diagnostics & broadcast commands
TELEGRAM_ADMIN_USER_ID="123456789"

# ------------------------------------------------------------------------------
# SOLANA RPC & WEBSOCKET CONFIGURATION
# ------------------------------------------------------------------------------
# For production sub-second sniping, use dedicated RPC/WSS endpoints:
# Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# Shyft:  https://rpc.shyft.to?api_key=YOUR_KEY
# QuickNode: https://solana-mainnet.quiknode.pro/YOUR_KEY/
# Triton / Jito / Dedicated Geyser gRPC Endpoint
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_WSS_URL="wss://api.mainnet-beta.solana.com"

# Commitment level for WebSocket stream ('processed' for ultra-low latency, or 'confirmed')
SOLANA_COMMITMENT="processed"

# ------------------------------------------------------------------------------
# PUMP.FUN CONSTANTS & TRACKING SETTINGS
# ------------------------------------------------------------------------------
# Pump.fun Mainnet Program ID (Default: 6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P)
PUMP_PROGRAM_ID="6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P"

# Maximum duration (in seconds) to actively track price updates for 5x / 10x surges (e.g., 90 seconds)
PRICE_SURGE_WINDOW_SECONDS=90

# Minimum initial SOL liquidity to alert (0 for all tokens)
MIN_LIQUIDITY_SOL=0.1

# Minimum price multiplier threshold to trigger moonshot replies
ALERT_SURGE_MULTIPLIER_5X=5.0
ALERT_SURGE_MULTIPLIER_10X=10.0

# ------------------------------------------------------------------------------
# AFFILIATE & REVENUE MONETIZATION PARAMETERS
# ------------------------------------------------------------------------------
# Trading bots provide affiliate programs. Insert your referral IDs here to
# generate passive SOL revenue from sniper button clicks in the channel.
# Note: Photon is routed directly without referral parameters.
TROJAN_REF="your_trojan_ref"
BONKBOT_REF="your_bonkbot_ref"
MAESTRO_REF="your_maestro_ref"
BULLX_REF="your_bullx_ref"

# Estimated SOL price in USD (for real-time market cap estimation fallback)
DEFAULT_SOL_USD_PRICE=180.0

# Port for optional health-check webserver / metrics
PORT=3000
